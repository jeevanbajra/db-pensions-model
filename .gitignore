# Data- not redistributable, and large
data/raw/
data/processed/*

# members.csv is synthetic and self-generated: no licence issue, keeps the repo runnable
!data/processed/members.csv

# gilt_curve.csv is a small extract from a rolling monthly source file that will not
# contain 28 July 2026 next month: committing it keeps the valuation reproducible
!data/processed/gilt_curve.csv

# gm_parameters.csv holds the fitted mortality parameters extracted once from a gitignored raw file.
# Commiting it ensures that the valuati is reproducible and lets the deployed dashboard read the basis without refitting.
!data/processed/gm_parameters.csv

# Python leftovers
__pycache__/
*.pyc

